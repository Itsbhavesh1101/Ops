    "PERF-001": {
      "title": "Flowable REST client lifecycle / connection reuse",
      "status": "RESOLVED",
      "root_cause": "Ephemeral per-request httpx.AsyncClient re-creation incurred fresh TCP connection socket setup and teardown overhead (~100-150ms per call) to local HTTP endpoint http://localhost:8080/flowable-rest/service.",
      "remediation": "Persistent shared httpx.AsyncClient with connection pooling (max_connections=20, max_keepalive=10, timeout=10.0s, keepalive_expiry=30s) and explicit lifecycle disposal.",
      "baseline": {
        "concurrency_1": { "throughput_rps": 6.32, "p95_ms": 176.34 },
        "concurrency_3": { "throughput_rps": 8.79, "p95_ms": 435.62 },
        "concurrency_5": { "throughput_rps": 9.67, "p95_ms": 654.78 }
      },
      "tuned": {
        "concurrency_1": { "throughput_rps": 7.76, "p95_ms": 150.25, "throughput_delta_pct": 22.8, "p95_delta_pct": -14.8 },
        "concurrency_3": { "throughput_rps": 20.07, "p95_ms": 204.45, "throughput_delta_pct": 128.3, "p95_delta_pct": -53.1 },
        "concurrency_5": { "throughput_rps": 26.13, "p95_ms": 246.88, "throughput_delta_pct": 170.2, "p95_delta_pct": -62.3 }
      },
      "task_execution": {
        "baseline_p95_ms": 225.27,
