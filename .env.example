# ==============================================================================
# IR INFOTECH E-7 OPERATIONS ENGINE - ENVIRONMENT TEMPLATE (.env.example)
# Foundational configuration variable names and safe development defaults.
# DO NOT COMMIT REAL CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# LOCAL DOCKER COMPOSE TOPOLOGY (TASK 1J.1)
# Safe development defaults for local Compose multi-container services.
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=operations_engine
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

FLOWABLE_DB=flowable_db
FLOWABLE_PORT=8080

PORT=8000

# ------------------------------------------------------------------------------
# APPLICATION (TASK 1B RUNTIME CONFIGURATION)
# ------------------------------------------------------------------------------
E7_APP_NAME="E-7 Operations Engine"
E7_ENVIRONMENT=local
E7_DEBUG=false
E7_LOG_LEVEL=INFO
E7_LOG_FORMAT=console
E7_CORRELATION_HEADER_NAME=X-Correlation-ID
E7_CORS_ALLOWED_ORIGINS=[]

# ------------------------------------------------------------------------------
# DATABASE (TASK 1D POSTGRESQL PERSISTENCE)
# Syntax example only. DO NOT place real passwords or connection strings here.
# ------------------------------------------------------------------------------
E7_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/operations_engine
E7_DATABASE_POOL_SIZE=5
E7_DATABASE_MAX_OVERFLOW=10
E7_DATABASE_POOL_TIMEOUT_SECONDS=30
E7_DATABASE_POOL_RECYCLE_SECONDS=1800
E7_DATABASE_CONNECT_TIMEOUT_SECONDS=10
E7_DATABASE_ECHO=false

# ------------------------------------------------------------------------------
# MESSAGE BROKER (TASK 1G.3A PUBLISHER & 1G.4C2 CONSUMER TRANSPORT)
# Syntax example only. DO NOT place real passwords or connection strings here.
# ------------------------------------------------------------------------------
E7_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
E7_RABBITMQ_EXCHANGE_NAME=events
E7_RABBITMQ_CONNECT_TIMEOUT_SECONDS=10.0
E7_RABBITMQ_CONSUMER_QUEUE_NAME=events.inbox
E7_RABBITMQ_CONSUMER_BINDING_KEYS='["#"]'
E7_RABBITMQ_DEAD_LETTER_EXCHANGE_NAME=events.dlx
E7_RABBITMQ_DEAD_LETTER_QUEUE_NAME=events.dlq
E7_RABBITMQ_DEAD_LETTER_ROUTING_KEY=dlq
E7_RABBITMQ_CONSUMER_MAX_CONCURRENCY=10

# ------------------------------------------------------------------------------
# OUTBOX WORKER RUNTIME (TASK 1J.3B OUTBOX-ONLY DISPATCHER)
# Operational policies for the outbox dispatcher runner.
# ------------------------------------------------------------------------------
E7_OUTBOX_POLL_INTERVAL_SECONDS=1.0
E7_OUTBOX_MAX_CONCURRENCY=1
E7_OUTBOX_SHUTDOWN_GRACE_SECONDS=10.0
E7_OUTBOX_LEASE_DURATION_SECONDS=30.0
E7_OUTBOX_PUBLISH_TIMEOUT_SECONDS=5.0
E7_OUTBOX_RETRY_BASE_DELAY_SECONDS=1.0
E7_OUTBOX_RETRY_MAX_DELAY_SECONDS=60.0
E7_OUTBOX_RETRY_MULTIPLIER=2.0

# ------------------------------------------------------------------------------
# AUTHENTICATION (TASK 1C.2 GOOGLE OIDC IDENTITY VERIFICATION)
# ------------------------------------------------------------------------------
E7_GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
E7_GOOGLE_OIDC_CLIENT_IDS=["example-client-id.apps.googleusercontent.com"]
E7_GOOGLE_OIDC_ALLOWED_HOSTED_DOMAINS=["example.com"]
E7_GOOGLE_OIDC_HTTP_TIMEOUT_SECONDS=10.0
E7_GOOGLE_OIDC_CLOCK_SKEW_SECONDS=60
E7_GOOGLE_OIDC_CACHE_FALLBACK_SECONDS=3600
E7_GOOGLE_OIDC_CACHE_MAX_SECONDS=86400

# ------------------------------------------------------------------------------
# AUTHENTICATION (TASK 1C.3 SERVICE API KEY VERIFICATION)
# Technical header configuration only. DO NOT place API keys or secrets here.
# ------------------------------------------------------------------------------
E7_SERVICE_API_KEY_HEADER_NAME=X-E7-Service-Key

# Legacy placeholders (to be resolved/cleaned in downstream auth tasks)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=ir-infotech-e7
JWKS_URL=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# TASK INTELLIGENCE AI PLANNER (PHASE 2B)
# All runtime settings must be externally configured. Zero production defaults.
# Values below are EXAMPLES / BENCHMARK CANDIDATES ONLY. DO NOT COMMIT REAL KEYS.
# ------------------------------------------------------------------------------
# E7_LLM_PROVIDER=openai_compatible                    # [EXAMPLE: e.g. openai_compatible, test]
# E7_LLM_PRIMARY_MODEL=sarvam-105b                     # [BENCHMARK CANDIDATE: e.g. sarvam-105b]
# E7_LLM_FALLBACK_MODEL=                               # [BENCHMARK CANDIDATE: optional fallback model]
# E7_LLM_BASE_URL=https://api.sarvam.ai/v1             # [EXAMPLE CANDIDATE ENDPOINT]
# E7_LLM_API_KEY=                                      # [REQUIRED FOR LIVE CALLS: api key]
# E7_LLM_TIMEOUT_SECONDS=30.0                          # [POLICY: bounded timeout in seconds]
# E7_LLM_MAX_RETRIES=2                                 # [POLICY: maximum transport retries]
# E7_LLM_MAX_REPAIR_ATTEMPTS=2                         # [POLICY: maximum targeted repair attempts]

# ------------------------------------------------------------------------------
# FLOWABLE (ADR-001 WORKFLOW RUNTIME BOUNDARY - PHASE 3A)
# Explicit configuration required when constructing FlowableAdapter.
# Zero silent defaults in production code. Values below are LOCAL EXAMPLES ONLY.
# ------------------------------------------------------------------------------
FLOWABLE_BASE_URL=http://localhost:8080/flowable-rest/service
FLOWABLE_TIMEOUT_SECONDS=10.0
FLOWABLE_MAX_RETRIES=2
FLOWABLE_USERNAME=admin
FLOWABLE_PASSWORD=test

# ------------------------------------------------------------------------------
# SCHEDULER
# ------------------------------------------------------------------------------
SOLVER_MAX_SECONDS=30
SOLVER_NUM_WORKERS=8
UNITIME_BASE_URL=http://localhost:8080/unitime/api
UNITIME_API_KEY=

# ------------------------------------------------------------------------------
# CALENDAR
# ------------------------------------------------------------------------------
CALENDAR_PROVIDER=local

# ------------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry - Task 1K)
# ------------------------------------------------------------------------------
# Master switch: disabled by default for zero-overhead local development.
E7_OTEL_ENABLED=false
# Logical service name (e.g. e7-api or e7-worker; required when E7_OTEL_ENABLED=true)
E7_OTEL_SERVICE_NAME=e7-api
# Logical service namespace (platform-level grouping)
E7_OTEL_SERVICE_NAMESPACE=e7
# Base OTLP/HTTP Collector endpoint without signal path (required when E7_OTEL_ENABLED=true)
# Note: Signal paths /v1/traces and /v1/metrics are appended automatically by runtime.
E7_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Trace sampling ratio between 0.0 and 1.0 (1.0 = sample all root traces)
E7_OTEL_TRACE_SAMPLE_RATIO=1.0
# Telemetry export timeout in seconds
E7_OTEL_EXPORT_TIMEOUT_SECONDS=10.0
# Metric export interval in seconds
E7_OTEL_METRIC_EXPORT_INTERVAL_SECONDS=60.0
AUDIT_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# OPTIONAL SERVICES
# ------------------------------------------------------------------------------
VALKEY_URL=
TEMPORAL_ADDRESS=
KAFKA_BOOTSTRAP_SERVERS=
